{
  // Type declarations of the published package (`npm run build:types`): SDK sources only.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["@webgpu/types"],
    "paths": {}
  },
  "include": ["src"]
}
