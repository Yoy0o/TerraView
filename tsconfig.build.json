{
  // Type declarations of the published package (`npm run build:types`): SDK sources only.
  // `stripInternal` drops declarations tagged `@internal` (API tiers: docs/api.md §3);
  // `tsconfig.dts.json` then checks that nothing public still points at one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["@webgpu/types"],
    "paths": {}
  },
  "include": ["src"]
}
